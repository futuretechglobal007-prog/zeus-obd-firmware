# Copy to /etc/zeus-obd.env (chmod 600). Never commit real keys.
ZEUS_DEVICE_SERIAL=PILOT-001
ZEUS_DEVICE_KEY=zdk_replace_with_key_from_pilot_page
# REAL for live driving, SANDBOX for bench tests
DATA_STATE=SANDBOX
# Leave empty to auto-detect; Bluetooth ELM327 is usually /dev/rfcomm0
OBD_PORT=
GNSS_PORT=/dev/ttyACM0
GNSS_BAUD=9600
SAMPLE_HZ=1
BATCH_SIZE=30
